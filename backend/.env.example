# ============================================================
# D01i Tweakz Backend - przykladowa konfiguracja (NIE commituj .env!)
# Skopiuj do .env i uzupelnij. Sekrety generuj:
#   SECURITY_PEPPER:      openssl rand -hex 32
#   Klucze Ed25519:       patrz docs/INSTALL_UBUNTU.md (sekcja "Klucze Ed25519")
# ============================================================

NODE_ENV=production
PORT=8080
HOST=127.0.0.1
PUBLIC_BASE_URL=https://api.twojadomena.pl

# PostgreSQL - lokalny, NIE wystawiany publicznie
DATABASE_URL=postgres://d01i_app:ZMIEN_MNIE@127.0.0.1:5432/d01i_tweakz
DB_POOL_MAX=10

# Sekrety
SECURITY_PEPPER=ZMIEN_MNIE_na_losowe_32 bajty
# R7: osobny pepper do HMAC hashy kluczy licencyjnych (zalecane inne niz SECURITY_PEPPER):
LICENSE_KEY_PEPPER=ZMIEN_MNIE_na_losowe_32_bajty
# R7: osobny uzytkownik migracyjny DB (opcjonalnie; bez tego uzywany DATABASE_URL):
# MIGRATIONS_DATABASE_URL=postgres://d01i_migrator:HASLO@127.0.0.1:5432/d01i_tweakz
# R7: wymuszaj MFA dla wszystkich kont adminow (zalecane w produkcji):
# ADMIN_REQUIRE_MFA=true
# Klucz szyfrowania sekretow w bazie (TOTP, webhook URL) - AES-256-GCM, 32 bajty:
SECRET_ENC_KEY=ZMIEN_MNIE_na_losowe_32_bajty
# Klucze podpisu tokenow (wybierz jedna opcje):
ED25519_PRIVATE_KEY_PATH=/etc/d01i-tweakz/keys/ed25519_private.pem
ED25519_PUBLIC_KEY_PATH=/etc/d01i-tweakz/keys/ed25519_public.pem
# lub bezposrednio PEM:
# ED25519_PRIVATE_KEY_PEM="-----BEGIN PRIVATE KEY-----..."
# ED25519_PUBLIC_KEY_PEM="-----BEGIN PUBLIC KEY-----..."
# TYLKO do lokalnych testow (klucze efemeryczne, tokeny nie przetrwaja restartu):
# ALLOW_EPHEMERAL_KEYS=true

# Tokeny licencyjne (dozwolony zakres 30-120 s; poza zakresem backend odmawia startu)
TOKEN_TTL_SECONDS=120
REFRESH_REPLAY_WINDOW_SECONDS=60
ADMIN_SESSION_TTL_HOURS=8
MAX_DEVICES_DEFAULT=2

# Bootstrap pierwszego admina (tylko przy pierwszej instalacji!)
ADMIN_BOOTSTRAP_ENABLED=false
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_PASSWORD=ZMIEN_MNIE_min_12_znakow

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_ACTIVATE_MAX=10
RATE_LIMIT_VALIDATE_MAX=120
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_ADMIN_API_MAX=120

# Wykrywanie naduzyc
ABUSE_FAILED_KEY_THRESHOLD=10
ABUSE_WINDOW_MINUTES=15
ABUSE_TEMP_BLOCK_MINUTES=30

# Opcjonalny webhook Discord (lub ustaw w panelu admina)
DISCORD_WEBHOOK_ENABLED=false
DISCORD_WEBHOOK_URL=
